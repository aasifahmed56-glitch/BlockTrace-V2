# BlockTrace — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit your .env file to version control.

# Etherscan API (v2, supports multiple EVM chains)
ETHERSCAN_API_KEY=

# Neo4j graph database (AuraDB or local instance)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Pinata (IPFS) — get credentials from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
PINATA_GATEWAY=

# Ethereum Sepolia Testnet — RPC endpoint and deployed smart contract addresses
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
CASE_CONTRACT_ADDRESS=
WALLET_PRIVATE_KEY=

# Case snapshot encryption — generate a 256-bit key using: python generate_key.py
CASE_ENCRYPTION_KEY=
